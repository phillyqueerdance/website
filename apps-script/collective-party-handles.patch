+// Party/collective Instagram cells may contain several handles or profile links.
+function addInstagramAliases(value, id, list) {
+String(value || '').split(',').forEach(token => {
+const handle = trim(token)
+.replace(/^https?:\/\/(?:www\.)?instagram\.com\//i, '')
+.replace(/[/?#].*$/, '').replace(/^@/, '');
+if (!/^[A-Za-z0-9._]+$/.test(handle)) return;
+const key = normalizeKey_(handle);
+const atKey = normalizeKey_('@' + handle);
+if (key) list.push({ key, id, exactOnly: false });
+if (atKey && atKey !== key) list.push({ key: atKey, id, exactOnly: false });
+});
+}
